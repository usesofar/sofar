{
  "name": "sofar.sh",
  "version": "0.35.0-rc.2",
  "description": "Sofar v1 engine — event log core, MCP server, CLI, hooks",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "sofar": "dist/cli.js",
    "sofar-core": "bin/sofar-core"
  },
  "exports": {
    "./schema": {
      "types": "./dist/types/engine/src/lib/schema.d.ts",
      "browser": "./dist/schema.browser.js",
      "default": "./dist/schema.js"
    },
    "./engine": {
      "types": "./dist/types/engine/src/lib/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./client": {
      "types": "./dist/types/engine/src/lib/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "install.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('README.md', { force: true })\"",
    "postinstall": "node install.mjs",
    "typecheck": "tsc --noEmit -p .",
    "bench:read-paths": "node bench/read-paths.mjs",
    "bench:find": "node bench/find.mjs"
  },
  "devDependencies": {
    "@sofar/schema": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "ulid": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesofar/sofar.git",
    "directory": "packages/engine"
  },
  "homepage": "https://sofar.sh",
  "bugs": {
    "url": "https://github.com/usesofar/sofar/issues"
  },
  "keywords": [
    "agents",
    "memory",
    "event-sourcing",
    "mcp",
    "claude-code",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@sofar.sh/core-darwin-arm64": "0.35.0-rc.2",
    "@sofar.sh/core-darwin-x64": "0.35.0-rc.2",
    "@sofar.sh/core-linux-x64": "0.35.0-rc.2",
    "@sofar.sh/core-linux-arm64": "0.35.0-rc.2",
    "@sofar.sh/core-win32-x64": "0.35.0-rc.2"
  }
}
