.sofar/**/events.jsonl merge=union
# The generated projections and shards (r3-fixes 2.1 and 2.14, memory-lead D45):
# a pure function of events.jsonl, re-rendered on the next append, so a merge of
# them must never conflict. `sofar doctor` checks these lines.
.sofar/**/plan.md merge=union linguist-generated
.sofar/**/decisions.md merge=union linguist-generated
.sofar/**/memory.md merge=union linguist-generated
.sofar/**/sessions/*.md merge=union linguist-generated
.sofar/**/brief.md merge=union linguist-generated
.sofar/**/decisions/*.md merge=union linguist-generated
.sofar/**/memory/*.md merge=union linguist-generated
.sofar/**/phases/*.md merge=union linguist-generated
packages/engine/test/conformance/fixtures/** linguist-generated

# Byte-exact fixtures (rust-core 3.2, first Windows CI run): the conformance
# cases, goldens and the Rust test fixtures are compared byte for byte, so a
# CRLF checkout (core.autocrlf on the Windows runner) must never rewrite them.
packages/engine/test/conformance/** text eol=lf
crates/sofar-core/tests/** text eol=lf
crates/sofar-schema/schema/** text eol=lf
